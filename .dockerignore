# Never ship node_modules, build output, or data into the image context.
node_modules/
server/node_modules/
server/client/node_modules/

# Build output (regenerated by the build step)
server/dist/
server/client/dist/

# SQLite databases — schema is created on boot, data lives on the volume
*.db
*.db-wal
*.db-shm

# Uploads
uploads/
server/uploads/

# Test scripts and scratch files
server/*.cjs
server/*.mjs
server/diag.txt

# VCS and deploy metadata
.git/
.gitignore
fly.toml
DEPLOY.md

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/