# Never ship node_modules, build output, or data into the image context.
node_modules/
server/node_modules/
server/client/node_modules/

# Build output (regenerated by the build step)
server/dist/

# SQLite databases — data lives on the persistent volume, not the image
*.db
*.db-wal
*.db-shm

# Uploads
uploads/
server/uploads/

# Test scripts and scratch files
server/*.cjs
server/*.mjs
server/diag.txt

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/