# Dependencies
node_modules/

# Build output (regenerated by the build step)
server/dist/
server/client/dist/

# SQLite databases. Note that `*.db` does not match `denyut.db.bak` or
# `denyut.db-wal`, so those are listed explicitly -- a stale backup here can
# be hundreds of megabytes of dead pages.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.db.bak
*.db.backup

# Uploads
uploads/
server/uploads/
server/test_uploads/

# Local secrets. `.env.example` is committed; real .env files never are.
.env
.env.*
!.env.example

# Test scripts
server/*.cjs
server/*.mjs
server/diag.txt

# Large test/template data files (not needed to run the app)
Template_*.xlsx
Cabang_Mandiri_Solo_Raya.xlsx
REKAM MEDIS CABANG JULI 2026.xlsx

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/