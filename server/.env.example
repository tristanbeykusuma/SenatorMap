# Turso / libSQL connection.
#
# Local development (the default): leave these unset and the server uses a
# local file at server/denyut.db. No network, no setup.
#
# Production: set both, and the server talks to a remote Turso database over
# HTTPS. This is what allows the app to run on a host with no persistent
# disk.
#
#   TURSO_DATABASE_URL=libsql://your-db-yourname.turso.io
#   TURSO_AUTH_TOKEN=eyJhbGciOi...
#
# Generate a token with:
#   npx @libsql/cli@latest auth token
#   npx @libsql/cli@latest db create senator-map
#   npx @libsql/cli@latest db tokens create --url libsql://senator-map-yourname.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. Only used when TURSO_DATABASE_URL is unset.
# DB_PATH=./denyut.db

# Writable scratch directory for uploaded workbooks. Files are parsed in the
# request that received them and then deleted, so this never needs to persist.
# On container hosts use /tmp/uploads.
# UPLOAD_DIR=/tmp/uploads
